<div class="d-flex justify-content-between align-items-center mb-4">
  <h3><i class="bi bi-folder me-2"></i>Documents for <%= patient.name %></h3>
  <a href="/documents/upload/<%= patient._id %>" class="btn btn-primary"><i class="bi bi-plus me-1"></i>Upload New</a>
</div>

<div class="row">
  <% documents.forEach(doc => { %>
  <div class="col-md-6 col-lg-4 mb-3">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <i class="bi bi-file-earmark-text fs-2 text-primary"></i>
          <span class="badge bg-<%= doc.processingStatus === 'completed' ? 'success' : doc.processingStatus === 'processing' ? 'warning' : 'secondary' %>">
            <%= doc.processingStatus %>
          </span>
        </div>
        <h6 class="card-title text-truncate" title="<%= doc.originalName %>"><%= doc.originalName %></h6>
        <p class="text-muted small mb-1"><%= doc.documentType %></p>
        <p class="text-muted small mb-2">
          <% if (doc.extractedData.dateOfReport) { %>
            Report Date: <%= new Date(doc.extractedData.dateOfReport).toLocaleDateString() %>
          <% } else { %>
            Uploaded: <%= new Date(doc.createdAt).toLocaleDateString() %>
          <% } %>
        </p>
        <a href="/documents/<%= doc._id %>/results" class="btn btn-sm btn-outline-primary w-100">View Extracted Data</a>
      </div>
    </div>
  </div>
  <% }) %>

  <% if (documents.length === 0) { %>
  <div class="col-12 text-center py-5">
    <i class="bi bi-inbox fs-1 text-muted"></i>
    <p class="text-muted mt-2">No documents uploaded yet.</p>
    <a href="/documents/upload/<%= patient._id %>" class="btn btn-primary">Upload First Document</a>
  </div>
  <% } %>
</div>

<div class="mt-3">
  <a href="/patients/<%= patient._id %>" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Patient</a>
</div>