<div class="d-flex justify-content-between align-items-center mb-4">
  <h3><i class="bi bi-database me-2 text-primary"></i>Patient Records</h3>
  <div>
    <a href="/dashboard" class="btn btn-outline-primary me-2">
      <i class="bi bi-speedometer2 me-1"></i>Dashboard
    </a>
    <a href="/patients/new" class="btn btn-primary">
      <i class="bi bi-plus-lg me-1"></i>New Case
    </a>
  </div>
</div>

<div class="card shadow-sm border-0">
  <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
    <h6 class="mb-0 text-muted"><i class="bi bi-hdd-network me-2"></i>ABDM / HIS Integrated Records</h6>
    <span class="badge bg-primary"><%= patients ? patients.length : 0 %> Records</span>
  </div>
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead class="table-light">
        <tr>
          <th>Record ID</th>
          <th>Patient Name</th>
          <th>Age / Gender</th>
          <th>Chief Complaint</th>
          <th>Status</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (patients && patients.length > 0) { %>
          <% patients.forEach(p => { %>
          <tr>
            <td>
              <code class="text-primary fw-bold">#<%= p._id.toString().slice(-6).toUpperCase() %></code>
            </td>
            <td>
              <div class="d-flex align-items-center">
                <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width:32px;height:32px;font-size:0.85rem;">
                  <%= p.name.charAt(0).toUpperCase() %>
                </div>
                <strong><%= p.name %></strong>
              </div>
            </td>
            <td><%= p.age %> / <%= p.gender %></td>
            <td><%= p.aiSummary?.chiefComplaint || 'N/A' %></td>
            <td>
              <span class="badge bg-<%= p.status === 'reviewed' ? 'success' : p.status === 'pending_review' ? 'warning' : p.status === 'flagged' ? 'danger' : 'secondary' %>">
                <%= p.status %>
              </span>
            </td>
            <td><%= new Date(p.createdAt).toLocaleDateString('en-IN') %></td>
            <td>
              <a href="/patients/<%= p._id %>" class="btn btn-sm btn-outline-primary me-1" title="View">
                <i class="bi bi-eye"></i>
              </a>
              <a href="/dashboard/review/<%= p._id %>" class="btn btn-sm btn-outline-success" title="Review">
                <i class="bi bi-clipboard-check"></i>
              </a>
            </td>
          </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center text-muted py-5">
              <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
              <h5>No Records Found</h5>
              <p>Patient records will appear here once cases are registered.</p>
              <a href="/patients/new" class="btn btn-primary mt-2">
                <i class="bi bi-person-plus me-1"></i>Register First Patient
              </a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>