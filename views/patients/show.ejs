
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm border-0">
      <div
        class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0"><i class="bi bi-person-circle me-2"></i><%=
          patient.name %></h4>
        <span class="badge bg-light text-dark"><%= patient.status %></span>
      </div>
      <div class="card-body p-4">
        <div class="row mb-3">
          <div class="col-md-6">
            <p class="mb-1"><strong>Age:</strong> <%= patient.age %> years</p>
            <p class="mb-1"><strong>Gender:</strong> <%= patient.gender %></p>
            <p class="mb-1"><strong>Phone:</strong> <%= patient.phone || 'N/A'
              %></p>
            <p class="mb-1"><strong>Email:</strong> <%= patient.email || 'N/A'
              %></p>
          </div>
          <div class="col-md-6">
            <p class="mb-1"><strong>Language:</strong> <%= patient.language
              %></p>
            <p class="mb-1"><strong>Case Type:</strong> <span
                class="badge bg-info"><%= patient.caseType %></span></p>
            <p class="mb-1"><strong>Registered:</strong> <%= new
              Date(patient.createdAt).toLocaleDateString() %></p>
          </div>
        </div>

        <hr>

        <div class="mb-3">
          <h6 class="text-primary">Symptoms</h6>
          <p><%= patient.symptoms?.join(', ') || 'Not recorded yet' %></p>
        </div>

        <div class="mb-3">
          <h6 class="text-primary">Medical History</h6>
          <p><%= patient.medicalHistory || 'No history provided' %></p>
        </div>

        <% if (patient.ayurvedaProfile && patient.ayurvedaProfile.prakriti) { %>
        <div class="mb-3 p-3 bg-ayurveda rounded">
          <h6 class="text-success"><i class="bi bi-leaf me-1"></i>Ayurvedic
            Profile</h6>
          <p class="mb-1"><strong>Prakriti:</strong> <%=
            patient.ayurvedaProfile.prakriti %></p>
          <p class="mb-1"><strong>Dosha:</strong> <%=
            patient.ayurvedaProfile.dosha %></p>
          <p class="mb-0"><strong>Agni:</strong> <%=
            patient.ayurvedaProfile.agni %></p>
        </div>
        <% } %>

        <% if (patient.aiSummary && patient.aiSummary.chiefComplaint) { %>
        <div class="mb-3 p-3 bg-light rounded border">
          <h6 class="text-primary"><i class="bi bi-robot me-1"></i>AI
            Summary</h6>
          <p class="mb-1"><strong>Chief Complaint:</strong> <%=
            patient.aiSummary.chiefComplaint %></p>
          <p class="mb-1"><strong>Diagnosis:</strong> <%=
            patient.aiSummary.suggestedDiagnosis %></p>
          <p class="mb-0"><strong>Confidence:</strong> <%=
            patient.aiSummary.confidence %>%</p>
        </div>
        <% } %>

        <div class="d-flex gap-2 mt-4">
          <a href="/patients/<%= patient._id %>/case-taking"
            class="btn btn-primary">
            <i class="bi bi-chat-dots me-1"></i>Continue Case Taking
          </a>
          <a href="/documents/upload/<%= patient._id %>"
            class="btn btn-outline-primary">
            <i class="bi bi-upload me-1"></i>Upload Documents
          </a>
          <a href="/patients" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to List
          </a>
        </div>
      </div>
    </div>
  </div>
</div>