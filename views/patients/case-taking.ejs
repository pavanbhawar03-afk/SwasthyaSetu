<div class="row">
  <div class="col-lg-4">
    <div class="card shadow-sm border-0 mb-3">
      <div class="card-header bg-info text-white"><i class="bi bi-person me-2"></i>Patient Profile</div>
      <div class="card-body">
        <h5><%= patient.name %></h5>
        <p class="mb-1 text-muted"><%= patient.age %> yrs | <%= patient.gender %></p>
        <p class="mb-1 text-muted"><i class="bi bi-telephone me-1"></i><%= patient.phone || 'N/A' %></p>
        <p class="mb-0"><span class="badge bg-secondary"><%= patient.language %></span> <span class="badge bg-primary"><%= patient.caseType %></span></p>
      </div>
    </div>
    <div class="card shadow-sm border-0">
      <div class="card-header bg-warning text-dark"><i class="bi bi-exclamation-circle me-2"></i>Red Flags</div>
      <div class="card-body" id="redFlagBox">
        <p class="text-muted small mb-0">No red flags detected yet.</p>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card shadow border-0 chat-card">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-robot me-2"></i>AI Case Assistant</span>
        <span class="badge bg-light text-dark"><i class="bi bi-mic me-1"></i>Voice Enabled</span>
      </div>
      <div class="card-body chat-body" id="chatBody" style="height: 450px; overflow-y: auto; background: #f8f9fa;">
        <div class="ai-message mb-3">
          <div class="d-flex align-items-start">
            <div class="avatar bg-primary text-white rounded-circle me-2 d-flex align-items-center justify-content-center" style="width:36px;height:36px;"><i class="bi bi-robot"></i></div>
            <div class="message-bubble bg-white border p-3 rounded-3 shadow-sm" style="max-width: 80%;">
              <p class="mb-0"><%= questions.greeting %></p>
              <small class="text-muted">AI Assistant</small>
            </div>
          </div>
        </div>
        <div class="ai-message mb-3">
          <div class="d-flex align-items-start">
            <div class="avatar bg-primary text-white rounded-circle me-2 d-flex align-items-center justify-content-center" style="width:36px;height:36px;"><i class="bi bi-robot"></i></div>
            <div class="message-bubble bg-white border p-3 rounded-3 shadow-sm" style="max-width: 80%;">
              <p class="mb-0"><%= questions.symptoms %></p>
              <small class="text-muted">AI Assistant</small>
            </div>
          </div>
        </div>
      </div>
      <div class="card-footer bg-white">
        <form id="chatForm" class="d-flex gap-2">
          <input type="hidden" id="currentStep" value="symptoms">
          <button type="button" class="btn btn-outline-secondary" id="voiceBtn"><i class="bi bi-mic"></i></button>
          <input type="text" id="userInput" class="form-control" placeholder="Type your response here..." autocomplete="off">
          <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i></button>
        </form>
        <div class="mt-2 text-center d-none" id="generateSummaryBtn">
          <button class="btn btn-success w-100" onclick="generateSummary()"><i class="bi bi-magic me-2"></i>Generate AI Clinical Summary</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
const patientId = '<%= patient._id %>';
const chatBody = document.getElementById('chatBody');
const chatForm = document.getElementById('chatForm');
const userInput = document.getElementById('userInput');
const currentStepInput = document.getElementById('currentStep');
const generateSummaryBtn = document.getElementById('generateSummaryBtn');
const redFlagBox = document.getElementById('redFlagBox');

chatForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  const message = userInput.value.trim();
  const step = currentStepInput.value;
  if (!message) return;

  // Add user message
  addMessage(message, 'user');
  userInput.value = '';

  // Call AI API
  const res = await fetch(`/patients/${patientId}/case-taking`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ response: message, step: step })
  });
  const data = await res.json();

  // Add AI response
  setTimeout(() => {
    addMessage(data.aiMessage, 'ai');
    currentStepInput.value = data.nextStep;
    
    if (data.isComplete) {
      generateSummaryBtn.classList.remove('d-none');
      chatForm.classList.add('d-none');
    }
    
    if (data.redFlagsDetected && data.redFlagsDetected.length > 0) {
      redFlagBox.innerHTML = data.redFlagsDetected.map(rf => `<div class="alert alert-danger py-1 px-2 mb-1 small"><i class="bi bi-exclamation-triangle me-1"></i>${rf}</div>`).join('');
    }
  }, 600);
});

function addMessage(text, sender) {
  const div = document.createElement('div');
  div.className = `mb-3 ${sender === 'user' ? 'text-end' : ''}`;
  const avatar = sender === 'ai' 
    ? `<div class="avatar bg-primary text-white rounded-circle me-2 d-flex align-items-center justify-content-center" style="width:36px;height:36px;"><i class="bi bi-robot"></i></div>`
    : '';
  const bubble = `
    <div class="d-flex align-items-start ${sender === 'user' ? 'flex-row-reverse' : ''}">
      ${avatar}
      <div class="message-bubble ${sender === 'user' ? 'bg-primary text-white' : 'bg-white border'} p-3 rounded-3 shadow-sm" style="max-width: 80%;">
        <p class="mb-0">${text}</p>
        <small class="${sender === 'user' ? 'text-white-50' : 'text-muted'}">${sender === 'ai' ? 'AI Assistant' : 'You'}</small>
      </div>
    </div>
  `;
  div.innerHTML = bubble;
  chatBody.appendChild(div);
  chatBody.scrollTop = chatBody.scrollHeight;
}

async function generateSummary() {
  const btn = document.querySelector('#generateSummaryBtn button');
  btn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Generating...';
  btn.disabled = true;
  
  const res = await fetch(`/patients/${patientId}/generate-summary`, { method: 'POST' });
  const data = await res.json();
  
  if (data.success) {
    window.location.href = data.redirect;
  }
}

// Voice input simulation
document.getElementById('voiceBtn').addEventListener('click', () => {
  alert('Voice recognition activated! (Browser Speech API would integrate here)');
});
</script>